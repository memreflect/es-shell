#!/bin/sh

set -Cefu

if [ $# -lt 3 ] || { [ "${0%%/*}" = "$0" ] && [ "$0" != mkprims ] ;}
then bad_usage=true
else bad_usage=false
fi

if $bad_usage ; then
    echo "usage: sh [path/to/]mkprims '[path/to/]cpp' 'cpp flags' filename..." >&2
    exit 2
fi

# ensure CPP doesn't have issues with missing prims.h
echo 'extern int n;' >| prims.h

CPP=$1
CPPFLAGS=$2
shift 2

for f in "$@" ; do

    # search for filename in the source directory (directory containing mkprims),
    # then the current directory
    if [ -f "${0%/*}/$f" ]
    then f="${0%/*}/$f"
    elif ! [ -f "$f" ]
    then
        echo "file not found -- $f" >&2
        exit 1
    fi

    # execute CPP with $f as the file to preprocess
    $CPP $CPPFLAGS "$f"

done |
    sed -ne '/^static List[^=]*prim_\([^()]*\)(/s,,\1,p' |
    awk '
BEGIN {
  primcount = 0
  print "/* prims.h -- generated by mkprims (do not edit!) */"
  print "static struct prim {"
  print "\tchar *name;"
  print "\tList *(*impl)(List *, Binding *, int);"
  print "} prims[] = {"
}

{
  primcount++
  printf "\t{ \"%s\", 0 },\n", $1
}

END {
  print "};"
  print "static size_t nprims = " primcount ";"
}
'
